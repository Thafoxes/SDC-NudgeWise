# Local XAMPP / phpMyAdmin: set DB_CLIENT=mariadb to use the new database.
# IMPORTANT: phpMyAdmin is only the admin UI; Node connects to XAMPP MariaDB.
# Never share .env or commit DB_PASSWORD to Git.
DB_CLIENT=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nudgewise_db
DB_USER=nudgewise_app
DB_PASSWORD=

# Copy to .env. Never put tokens in VITE_* variables.
# Enable server persistence and customer-document OCR with the local API.
VITE_BACKEND_ENABLED=true
OLLAMA_API_KEY=
# Exact beneficiary account name expected on test receipts. Empty => review all.
RECEIPT_BENEFICIARY=Kedai Maju Jaya Sdn Bhd
# Python 3.11/3.12 virtual environment with server/requirements.txt installed.
FRONTEND_ORIGIN=http://localhost:5173

# Local Ollama / cloud Ollama modes: off | ollama | cloud | auto
AI_PROVIDER=auto
AI_TIMEOUT_MS=30000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
CLOUD_AI_PROVIDER=ollama # only Ollama /api/chat protocol is implemented
CLOUD_AI_BASE_URL=https://ollama.com
# Set to a model available on your cloud account; defaults to OLLAMA_MODEL.
CLOUD_AI_MODEL=
# CLOUD_AI_API_KEY= (optional; backend only, never VITE_*)
# Ubuntu OCR Python; install server/requirements.txt into this environment first.
DOCLING_PYTHON=.venv/bin/python

# On Ubuntu, create a venv at project root and install server/requirements.txt:
# python3 -m venv .venv && .venv/bin/python -m pip install -r server/requirements.txt
# DOCLING_PYTHON=.venv/bin/python
